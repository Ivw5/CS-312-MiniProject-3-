<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>All Blogs</title>
    <link rel="stylesheet" href="index.css">
</head>
<body class = "body">
    <header class="header">
    <nav>
        <ul>
            <li><a class="header-link" href="/">Create Blog</a></li>
            <li><a class="header-link" href="/blogs">Blogs</a></li>

            <li class="push-right">
                <% if (currentUser) { %>

                    <span class="welcome-message">
                        Welcome, <%= currentName %>!
                    </span>

                    <a class= "welcome-message" href="/logout">Logout</a>

                <% } else { %>

                    <a href="/signin">Sign In</a>
                    |
                    <a href="/signup">Sign Up</a>

                <% } %>
            </li>
        </ul>
    </nav>
</header>
    <style>
        body {
            background-image: url('./images/background.jpg');
            background-size: cover;
        }
    </style>
    <h1>All Blogs</h1>

    <div class="blog-container">
        <% if (posts.length === 0) { %>
        <div class="no-blogs-message">
            <p style= "color: purple; text-align: center;">No current blogs available.</p>
            <a href = "/">
                <button class="reg-btn" >Create the first blog post!</button>
            </a>
        </div>
        <% } else { %>
        
            <% posts.forEach((post) => { %>

                <div class="blog-box" data-post-id="<%= post.blog_id %>">

                    <% if (currentUser === post.creator_user_id) { %>

                        <div class="post-actions">
                            <button class="btn-edit"
                                onclick="editPost(<%= post.blog_id %>)">
                                Edit
                            </button>

                            <button class="btn-delete"
                                onclick="deletePost(<%= post.blog_id %>)">
                                Delete
                            </button>
                        </div>

                    <% } %>

                    <h2 class="post-name"><%= post.creator_name %></h2>

                    <h3 class="post-title"><%= post.title %></h3>

                    <small>
                        <%= new Date(post.date_created).toLocaleString() %>
                    </small>

                    <p class="post-text"><%= post.body %></p>

                </div>

            <% }) %>
         <% } %>
        <div class="post-actions">
            
            
    </div>
    </div>
    <script>
        function editPost(postId) {
            // Redirects browser to the edit route for this specific post ID
            window.location.href = `/blogs/edit/${postId}`;
        }

        function deletePost(postId) {
            const confirmDelete = confirm("Are you sure you want to delete this post?");
            if (confirmDelete) {
                // Send a DELETE request to your Express server
                fetch(`/blogs/delete/${postId}`, {
                    method: 'POST' // Using POST as a simpler fallback for standard HTML forms/requests
                }).then(response => {
                    if (response.ok) {
                        // Visually remove it from the DOM if the server successfully processed it
                        document.querySelector(`[data-post-id="${postId}"]`).remove();
                        alert("Post deleted successfully!");
                    } else {
                        alert("Failed to delete post.");
                    }
                });
            }
        }
    </script>
</body>
</html>
