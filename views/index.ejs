<!DOCTYPE html>
<html lang="en">
    

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blog</title>
  <link rel="stylesheet" href="index.css">
</head>




   

<body class = "body">
    </style>
    <header class="header">
    <nav>
        <ul>
            <li><a class="header-link" href="/">Create Blog</a></li>
            <li><a class="header-link" href="/blogs">Blogs</a></li>

            <li class="push-right">
                <% if (currentUser) { %>

                    <span class="welcome-message">
                        Welcome, <%= currentName %>!
                    </span>

                    <a class= "welcome-message" href="/logout">Logout</a>

                <% } else { %>

                    <a href="/signin">Sign In  |</a>
                    
                    <a href="/signup">Sign Up</a>

                <% } %>
            </li>
        </ul>
    </nav>
</header>
    <h1>Welcome to the Blog! </h1>
    <h1>Make a Post!</h1>
    <div class = box>
        <form action="/submit" method="POST">
            <label class="label" for="title">Blog Title:</label>
            <input type="text" id="title" name="title" required>

            <label class="label" for="Date">Date:</label>
            <input type="date" id="Date" name="Date" required>

            <label class="label" for="text">Your Blog Post:</label>
            <textarea
                class="custom-box"
                id="text"
                name="text"
                placeholder="Start typing here..."
                required></textarea>

            <input class="reg-btn" type="submit" value="Submit">
        </form>
    </div>
</body>

</html>